{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/*.css",
          "/*.js",
          "/assets/**",
          "/images/**",
          "/docs/**"
        ]
      }
    },
    {
      "name": "landing-images",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "urls": [
          "/api/Images/**"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "landing-pages",
      "urls": [
        "/api/LandingPages/slug/**",
        "/api/Product/**",
        "/api/Categories/**",
        "/api/Location/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 100,
        "maxAge": "1d",
        "timeout": "5s"
      }
    }
  ],
  "navigationUrls": [
    "/**",
    "!/**/*.*",
    "!/api/**"
  ]
}
